# Leave GOOGLE_CLOUD_PROJECT unset to use the local JSON-backed store/Memory Bank fallback.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.5+ models are only served from the "global" endpoint, not regional ones like us-central1.
GEMINI_LOCATION=global
# Agent Engine backing the real GEAP Memory Bank. Unset = local/Firestore fallback.
# Create one with: python -m soc_agent.scripts.provision_memory_bank
AGENT_ENGINE_ID=
# Uncomment and set only if using the Firestore emulator instead of real Firestore:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Live Gmail source (soc_agent/sources/gmail.py). Leave unset to run the
# dashboard with the replay feed only. Mint these with:
#   python -m soc_agent.scripts.gmail_auth
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
